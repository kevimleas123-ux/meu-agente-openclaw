# ==========================================================
# Copie este arquivo para .env  ->  cp .env.example .env
# NUNCA suba o arquivo .env para o GitHub (ele tem senhas).
# ==========================================================

# --- Modelo de IA (Claude / Anthropic) ---
# Pegue em: https://console.anthropic.com  -> API Keys
ANTHROPIC_API_KEY=coloque-sua-chave-aqui

# --- Telegram ---
# Crie o bot conversando com @BotFather no Telegram (/newbot)
TELEGRAM_BOT_TOKEN=coloque-o-token-do-botfather-aqui

# --- Fuso horario ---
TZ=America/Sao_Paulo
